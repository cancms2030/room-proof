---
// import Layout from '~/layouts/Layout.astro';
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: '酒店保洁管理系统_客房质检软件_让清洁有据可查-净证',
  description:
    '净证专为中小酒店设计，拍照留痕、在线审核、自动报表，告别微信群+Excel的原始管理模式。让每一间客房的清洁都有据可查。',
};

const features = [
  {
    icon: 'tabler:camera',
    title: '拍照留痕，有图有真相',
    desc: '保洁员逐项拍照上传，每张照片自带时间水印与房间编号，退房争议一键回溯。',
    link: '/features/photo-inspection/',
  },
  {
    icon: 'tabler:file-check',
    title: '在线审核，责任到人',
    desc: '主管手机端实时审核，通过/驳回/整改全流程闭环，责任可追踪到每一次操作。',
    link: '/features/photo-inspection/#review',
  },
  {
    icon: 'tabler:chart-bar',
    title: '自动报表，数据驱动决策',
    desc: '质检合格率、员工绩效、问题分布自动生成图表，让运营决策有数据支撑。',
    link: '/features/report-center/',
  },
];

const painPoints = [
  { label: '消息刷屏，信息淹没' },
  { label: 'Excel零散，数据难汇总' },
  { label: '凭印象分，标准不统一' },
  { label: 'PMS太贵，用不起' },
];

const solutions = [
  { label: '记录沉淀，随时回溯' },
  { label: '数据汇总，一目了然' },
  { label: '标准统一，公平公正' },
  { label: '按年付费，低成本' },
];
---

<Layout {metadata}>
  <!-- ===== Hero 区 ===== -->
  <section class="relative overflow-hidden bg-gradient-to-br from-blue-950 via-blue-900 to-blue-800 py-20 md:py-32">
    <div
      class="absolute inset-0 opacity-[0.03]"
      style="background-image: radial-gradient(circle, #ffffff 1px, transparent 1px); background-size: 40px 40px;"
    >
    </div>
    <div class="container relative z-10 mx-auto px-4 text-center">
      <h1 class="text-4xl font-extrabold leading-tight tracking-tight text-white md:text-6xl">
        让每一间客房的清洁，<br class="hidden sm:block" />都有据可查
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg text-blue-100 md:text-xl">
        专为中小酒店设计的客房保洁质检系统 — 拍照留痕、在线审核、自动报表
      </p>
      <div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a
          href="/contact/"
          class="inline-flex items-center rounded-full bg-gradient-to-r from-blue-500 to-blue-600 px-8 py-4 text-lg font-semibold text-white shadow-lg shadow-blue-500/30 transition-all hover:from-blue-600 hover:to-blue-700 hover:shadow-xl hover:shadow-blue-500/40"
        >
          免费试用
          <span class="iconify ml-2" data-icon="tabler:arrow-right"></span>
        </a>
        <a
          href="/features/"
          class="inline-flex items-center rounded-full border-2 border-white/30 px-8 py-4 text-lg font-semibold text-white backdrop-blur-sm transition-all hover:border-white/60 hover:bg-white/10"
        >
          查看功能
          <span class="iconify ml-2" data-icon="tabler:chevron-down"></span>
        </a>
      </div>
    </div>
    <div class="absolute bottom-0 left-0 right-0">
      <svg
        viewBox="0 0 1440 80"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        preserveAspectRatio="none"
        class="h-16 w-full md:h-20"
      >
        <path
          d="M0 40C240 80 480 0 720 40C960 80 1200 0 1440 40V80H0V40Z"
          fill="currentColor"
          class="text-white dark:text-slate-950"></path>
      </svg>
    </div>
  </section>

  <!-- ===== 三大核心功能 ===== -->
  <section class="bg-white py-20 md:py-28 dark:bg-slate-950">
    <div class="container mx-auto px-4">
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="text-3xl font-extrabold tracking-tight text-gray-900 md:text-4xl dark:text-white">
          三大核心功能，重塑酒店保洁标准
        </h2>
        <p class="mt-4 text-lg text-gray-500 dark:text-gray-400">从拍照到报表，覆盖客房清洁全流程</p>
      </div>
      <div class="mt-16 grid gap-8 md:grid-cols-3">
        {
          features.map((feat) => (
            <div class="group relative flex flex-col items-center rounded-2xl border border-gray-100 bg-white p-8 text-center shadow-sm transition-all duration-300 hover:-translate-y-1 hover:border-blue-100 hover:shadow-xl hover:shadow-blue-50 dark:border-slate-800 dark:bg-slate-900 dark:hover:border-blue-900 dark:hover:shadow-blue-950/30">
              <div class="flex h-16 w-16 items-center justify-center rounded-2xl bg-gradient-to-br from-blue-500 to-blue-600 shadow-lg shadow-blue-500/20 transition-transform duration-300 group-hover:scale-110">
                <span class="iconify h-8 w-8 text-white" data-icon={feat.icon} />
              </div>
              <h3 class="mt-6 text-xl font-bold text-gray-900 dark:text-white">{feat.title}</h3>
              <p class="mt-3 leading-relaxed text-gray-500 dark:text-gray-400">{feat.desc}</p>
              <a
                href={feat.link}
                class="mt-6 inline-flex items-center gap-1 text-sm font-semibold text-blue-600 transition-colors hover:text-blue-700 dark:text-blue-400 dark:hover:text-blue-300"
              >
                了解更多
                <span class="iconify" data-icon="tabler:arrow-narrow-right" />
              </a>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ===== 痛点对比区 ===== -->
  <section class="bg-gray-50 py-20 md:py-28 dark:bg-slate-900">
    <div class="container mx-auto px-4">
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="text-3xl font-extrabold tracking-tight text-gray-900 md:text-4xl dark:text-white">
          告别微信群+Excel的原始管理
        </h2>
        <p class="mt-4 text-lg text-gray-500 dark:text-gray-400">看看净证如何帮您解决这些头疼的问题</p>
      </div>
      <div class="mt-16 grid gap-8 md:grid-cols-2">
        <!-- 左侧痛点 -->
        <div class="rounded-2xl border border-red-100 bg-white p-8 shadow-sm dark:border-red-900/30 dark:bg-slate-800">
          <div class="mb-6 flex items-center gap-3">
            <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-red-50 dark:bg-red-900/20">
              <span class="iconify h-6 w-6 text-red-500" data-icon="tabler:x"></span>
            </div>
            <h3 class="text-xl font-bold text-red-600 dark:text-red-400">传统管理方式</h3>
          </div>
          <ul class="space-y-4">
            {
              painPoints.map((item) => (
                <li class="flex items-center gap-3 rounded-xl border border-red-50 bg-red-50/50 p-4 dark:border-red-900/20 dark:bg-red-900/10">
                  <span class="flex h-6 w-6 flex-shrink-0 items-center justify-center rounded-full bg-red-100 text-xs font-bold text-red-500 dark:bg-red-900/40 dark:text-red-400">
                    ✕
                  </span>
                  <span class="text-gray-700 dark:text-gray-300">{item.label}</span>
                </li>
              ))
            }
          </ul>
        </div>
        <!-- 右侧方案 -->
        <div
          class="rounded-2xl border border-green-100 bg-white p-8 shadow-sm dark:border-green-900/30 dark:bg-slate-800"
        >
          <div class="mb-6 flex items-center gap-3">
            <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-green-50 dark:bg-green-900/20">
              <span class="iconify h-6 w-6 text-green-500" data-icon="tabler:check"></span>
            </div>
            <h3 class="text-xl font-bold text-green-600 dark:text-green-400">净证解决方案</h3>
          </div>
          <ul class="space-y-4">
            {
              solutions.map((item) => (
                <li class="flex items-center gap-3 rounded-xl border border-green-50 bg-green-50/50 p-4 dark:border-green-900/20 dark:bg-green-900/10">
                  <span class="flex h-6 w-6 flex-shrink-0 items-center justify-center rounded-full bg-green-100 text-xs font-bold text-green-500 dark:bg-green-900/40 dark:text-green-400">
                    ✓
                  </span>
                  <span class="text-gray-700 dark:text-gray-300">{item.label}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== CTA 区 ===== -->
  <section class="relative overflow-hidden bg-gradient-to-br from-blue-950 via-blue-900 to-indigo-900 py-20 md:py-28">
    <div class="absolute -top-40 left-1/2 h-96 w-96 -translate-x-1/2 rounded-full bg-blue-500/20 blur-3xl"></div>
    <div class="container relative z-10 mx-auto px-4 text-center">
      <h2 class="text-3xl font-extrabold tracking-tight text-white md:text-4xl">立即开启您的酒店无纸化保洁管理</h2>
      <p class="mx-auto mt-4 max-w-xl text-lg text-blue-100">免费试用14天， 全程一对一指导</p>
      <div class="mt-10">
        <a
          href="/contact/"
          class="inline-flex items-center rounded-full bg-gradient-to-r from-blue-400 to-blue-500 px-10 py-5 text-lg font-bold text-white shadow-xl shadow-blue-500/40 transition-all hover:from-blue-500 hover:to-blue-600 hover:shadow-2xl hover:shadow-blue-500/50 hover:scale-105"
        >
          免费试用
          <span class="iconify ml-2 h-5 w-5" data-icon="tabler:arrow-right"></span>
        </a>
      </div>
      <p class="mt-6 text-sm text-blue-300/70">14天全功能体验 · 专属客服指导</p>
    </div>
  </section>
</Layout>
