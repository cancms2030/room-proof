---
import Features2 from '~/components/widgets/Features2.astro';
import Features3 from '~/components/widgets/Features3.astro';
import Hero from '~/components/widgets/Hero.astro';
import Stats from '~/components/widgets/Stats.astro';
import Steps2 from '~/components/widgets/Steps2.astro';
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: '关于我们 - 净证',
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    tagline="关于我们"
    image={{
      src: 'https://images.unsplash.com/photo-1618773928121-c32242e63f39?w=1200&h=600&fit=crop',
      alt: '酒店保洁场景',
    }}
  >
    <Fragment slot="title">
      让每一间客房的清洁，都有据可查
    </Fragment>

    <Fragment slot="subtitle">
      我们是一支专注于酒店保洁数字化管理的团队。通过深入一线酒店场景，
      我们发现主管与保洁员之间"微信传图"的种种弊端，决心用技术手段解决"检查效率低"和"标准落地难"两大行业顽疾。
      产品以"强制水印采集 + 异常自动过滤 + 数据看板"为核心，帮助酒店实现保洁管理的减负、提效、可追溯。
    </Fragment>
  </Hero>

  <!-- Stats Widget ****************** -->

  <Stats
    title="我们的初心"
    stats={[
      { title: '产品打磨', amount: '6个月' },
      { title: '试点酒店', amount: '3家' },
      { title: '目标效率提升', amount: '60%' },
      { title: '用户满意度', amount: '95%' },
    ]}
  />

  <!-- Features3 Widget ************** -->

  <Features3
    title="我们的核心优势"
    subtitle="专注酒店保洁质检场景，每一行代码都懂你的需求"
    columns={3}
    isBeforeContent={true}
    items={[
      {
        title: '场景深耕',
        description:
          '我们深入酒店一线，理解主管与保洁员的真实痛点，产品设计贴合实际工作流程，上线即用。',
        icon: 'tabler:building-community',
      },
      {
        title: '简单易用',
        description:
          '保洁员无需培训即可上手，拍照即上传；主管无需复杂操作，一键审图，轻松管理。',
        icon: 'tabler:thumb-up',
      },
      {
        title: '数据驱动',
        description:
          '自动生成员工绩效、通过率、返工率等核心报表，让管理从"凭感觉"走向"用数据说话"。',
        icon: 'tabler:chart-bar',
      },
    ]}
  />

  <!-- Features3 Widget ************** -->

  <Features3
    columns={3}
    isAfterContent={true}
    items={[
      {
        title: '强制水印拍照',
        description:
          '自动叠加时间、房号水印，杜绝旧图顶替，确保每一张照片都真实可追溯。',
        icon: 'tabler:camera',
      },
      {
        title: '标准点位清单',
        description:
          '预设全景、床铺、马桶、台盆、杯具、地面等检查点位，按序拍照，防止漏项。',
        icon: 'tabler:list-check',
      },
      {
        title: '异常自动标记',
        description:
          '发现问题时弹窗提醒，保洁员可快速标记问题类型，主管重点关注异常房间。',
        icon: 'tabler:alert-circle',
      },
      {
        title: '在线审核与驳回',
        description:
          '主管在线查看照片，一键通过或驳回，驳回原因直达保洁员，整改有方向。',
        icon: 'tabler:file-check',
      },
      {
        title: '员工绩效看板',
        description:
          '自动统计每位保洁员的打扫数、通过率、返工率，排行榜一目了然。',
        icon: 'tabler:trophy',
      },
      {
        title: '数据报表导出',
        description:
          '月度质量报表一键导出，常见问题分析精准定位培训方向，不再凭感觉管理。',
        icon: 'tabler:file-spreadsheet',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1434626881859-194d67b2b86f?w=1200&h=600&fit=crop',
      alt: '数字化管理场景',
    }}
  />

  <!-- Steps2 Widget ****************** -->

  <Steps2
    title="我们的价值观"
    subtitle="用技术赋能一线，用数据驱动管理，让每一间客房的清洁都值得信赖"
    items={[
      {
        title: '用户至上',
        description:
          '我们深入酒店一线，倾听主管与保洁员的真实声音，产品迭代始终以用户需求为中心。',
      },
      {
        title: '简单务实',
        description:
          '拒绝复杂冗余的设计，追求极简操作与极致的用户体验，让技术真正为人所用。',
      },
      {
        title: '数据说话',
        description:
          '相信数据的力量，用客观的报表替代主观的判断，帮助酒店管理者做出更明智的决策。',
      },
    ]}
  />

  <!-- Steps2 Widget ****************** -->

  <Steps2
    title="我们的竞争力"
    subtitle="直击行业痛点，用轻量化方案解决真实问题"
    isReversed={true}
    callToAction={{
      text: '了解更多',
      href: '/features/',
    }}
    items={[
      {
        title: '🔒 强制水印防造假',
        description: '时间戳精确到秒、房间号自动关联，杜绝旧图顶替，确保每一张照片真实可追溯。',
        icon: 'tabler:shield-check',
      },
      {
        title: '⚡ 异常自动过滤',
        description: '系统自动筛选问题照片，主管只看异常，合格照片直接归档，审图效率提升60%。',
        icon: 'tabler:filter',
      },
      {
        title: '📊 数据驱动管理',
        description: '自动生成员工绩效、通过率、返工率报表，月底10分钟导出，告别手工翻聊天记录。',
        icon: 'tabler:chart-bar',
      },
    ]}
  />

  <!-- Technical Support section temporarily hidden -->
</Layout>
